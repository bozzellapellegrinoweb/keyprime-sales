# ============================================================
# KeyPrime Portal - variabili ambiente
# Da impostare su Vercel (Project Settings > Environment Variables).
# Nessuna di queste chiavi deve finire nel repository.
# ============================================================

# --- Supabase ---------------------------------------------------------------
# La service_role key scavalca RLS: solo lato server, mai nel bundle client.
SUPABASE_URL=https://wqtylxrrerhbxagdzftn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Notifiche --------------------------------------------------------------
ONESIGNAL_APP_ID=071cd2c3-4a3d-4d2f-8deb-fa575aec578d
ONESIGNAL_REST_API_KEY=
RESEND_API_KEY=
MAIL_FROM=KeyPrime <notifiche@keyprimere.com>
MAIL_REPLY_TO=info@keyprimere.com
ADMIN_EMAIL=bozzellapellegrino@gmail.com
APP_URL=https://portal.keyprimere.com

# --- GoHighLevel ------------------------------------------------------------
# GHL_API_KEY: Private Integration Token della location KeyPrime.
#   Scope necessari: contacts.write, contacts.readonly,
#   conversations.write, conversations/message.write,
#   opportunities.write, opportunities.readonly, workflows.readonly
# GHL_WEBHOOK_SECRET: segreto a scelta, da mettere anche nell'header
#   x-kp-secret del webhook configurato dentro GHL.
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_WEBHOOK_SECRET=
GHL_API_BASE=https://services.leadconnectorhq.com

# --- Job pianificati --------------------------------------------------------
# CRON_SECRET lo genera Vercel. KP_JOB_SECRET serve solo per lanciare
# i job a mano durante il collaudo.
KP_JOB_SECRET=

# --- PropertyFinder (sync progetti off-plan) --------------------------------
PF_API_HOST=uae-real-estate-api-propertyfinder-ae-data.p.rapidapi.com
PF_API_KEY=

# --- Generazione descrizioni ------------------------------------------------
ANTHROPIC_API_KEY=
